{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "noEmit": true
  },
  "include": [
    "src/web",
    "src/State",
    "src/Events",
    "src/Mining",
    "src/TileGridGeneration",
    "src/Typescript",
    "vite.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".tsbuild",
    "src/Mining/Console",
    "src/Mining/checks.ts"
  ]
}
